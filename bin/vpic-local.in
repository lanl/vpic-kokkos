#! /usr/bin/env bash

deck=`echo $1 | sed 's,\.cxx,,g;s,\.cc,,g;s,\.cpp,,g;s,.*\/,,g'`

clean_kokkos_path()
{
    # $1 = path
    # $2 = swap ; for $2
    if grep -q ";" <<< "$1"; then
      echo $(echo $1 | sed "s/;/ $2/g")
    else
      echo ${2}${1}
    fi
}

KOKKOS_INCLUDES=$( cat @KOKKOS_INCLUDES_FILE@ )
KOKKOS_COMPILE_OPTIONS=$( cat @KOKKOS_COMPILE_OPTIONS_FILE@ )

KOKKOS_LIB_PATHS=$KOKKOS_INCLUDES

echo $KOKKOS_LIB_PATHS

# Add hack to include ../lib and ../lib64, only required for "external" builds
# If only a single path was passed append the paths
if ! grep -q ";" <<< "$KOKKOS_LIB_PATHS"; then
    # We pre append ";" to make the above subsition work when cleaning the path
    KOKKOS_LIB_PATHS=";${KOKKOS_LIB_PATHS};${KOKKOS_LIB_PATHS}/../lib/;${KOKKOS_LIB_PATHS}/../lib64/"
fi

KOKKOS_INCLUDES=$(clean_kokkos_path $KOKKOS_INCLUDES -I)

KOKKOS_LIB_PATHS=$(clean_kokkos_path $KOKKOS_LIB_PATHS -L)

KOKKOS_LIBS="-lkokkoscore -lkokkoscontainers -lkokkosalgorithms -lkokkossimd"


echo "$1"
set -x
@CMAKE_CXX_COMPILER@ @VPIC_CPPFLAGS@ @CMAKE_CXX_FLAGS@ -I. -I@CMAKE_SOURCE_DIR@/src @VPIC_CXX_FLAGS@ $KOKKOS_COMPILE_OPTIONS -DINPUT_DECK='"'$1'"' @DirDefs@ @CMAKE_SOURCE_DIR@/deck/main.cc @CMAKE_SOURCE_DIR@/deck/wrapper.cc -o $deck.@CMAKE_SYSTEM_NAME@ -Wl,-rpath,@CMAKE_BINARY_DIR@ -L@CMAKE_BINARY_DIR@ -lvpic @VPIC_CXX_LIBRARIES@ -lpthread -ldl $KOKKOS_LIB_PATHS $KOKKOS_INCLUDES $KOKKOS_LIBS
set +x
