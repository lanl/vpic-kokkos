// Test Cyclotron motion in a constant magnetic field
//
// Note:
// wc = q B / m gamma ==> wc dt = q dt B / m gamma ==>
// wc dt = q dt c B / m c gamma ==> wc dt = 2 ( q dt / 2 m c ) ( c B ) / gamma
//
// With c = 1, dt = 1, gamma = 2, q = 2, m = 1
// wc dt = c B
// 2 pi dt / tauc = c B
// 2 pi / Nstep = c B
//
// This input deck was written by:
//   Kevin J Bowers, Ph.D.
//   Plasma Physics Group (X-1)
//   Applied Physics Division
//   Los Alamos National Lab
// March/April 2004 - conversion of c++ test code into an input deck

begin_globals {
};

begin_initialization {
  int nstep = 100/dt_test_value;

  define_units( 1, 1 );
  define_timestep( dt_test_value );
  // Grid in cylindrical: (r, theta, z)
  define_periodic_grid( 0.2, 0, 0,   // Grid low corner (r_min, theta_min, z_min)
                        2.0, 2*M_PI, 1,   // Grid high corner (r_max, theta_max, z_max)
                        100, 100, 1,   // Grid resolution
                        1, 1, 1 ); // Processor configuration
  define_material("vacuum",1.0,1.0,0.0);
  define_field_array();

  grid->init_cylindrical_grid(0.1, 2.0,
                              0, 2*M_PI,
                              0, 1.0,
                              false, true, false);
  grid->init_kokkos_grid(6*grid->nv);

  double q = 1.0;
  double m = 1.0;
  double R = 1.0;
  double vx = 0.1;
  double B = vx*m/q/R;
  // Initialize B field in ALL voxels including ghost cells
  // Physical domain: i,j,k in [1,nx] x [1,ny] x [1,nz]
  // Ghost cells: i=0, i=nx+1, j=0, j=ny+1, k=0, k=nz+1
  for(int k=0; k<=grid->nz+1; k++) {
    for(int j=0; j<=grid->ny+1; j++) {
      for(int i=0; i<=grid->nx+1; i++) {
        field(i,j,k).cbz0 = B;
      }
    }
  }

  field_array->copy_to_device();

  species_t* sp; // We use this to iterate over species

  species_t * this_sp = define_species( "test_species", q, m, 1, 1, 0, 0 );
  // Inject particles in cylindrical coordinates (r, theta, z)
  inject_particle( this_sp,
                    R,  // r
                    M_PI,  // theta
                    0.0,  // z
                    0, vx, 0, // Cartesian velocity (vx, vy, vz) for Gamma = 2
                    1.0, // w
                    0, 0 );

  LIST_FOR_EACH( sp, species_list ) {
    sp->copy_to_device();
  }
  interpolator_array->copy_to_device();

  load_interpolator_array( interpolator_array, field_array );
  double r_phys;
  for( int n=0; n<nstep; n++ ) {

    LIST_FOR_EACH( sp, species_list ) {
      sp->copy_to_host();
    }

    // Decompose voxel index: VOXEL(ix,iy,iz,nx,ny,nz) = ix + (nx+2)*(iy + (ny+2)*iz)
    int voxel = this_sp->p[0].i;
    int nxp2 = grid->nx + 2;
    int nyp2 = grid->ny + 2;
    int iz = voxel / (nxp2 * nyp2);
    int rem = voxel % (nxp2 * nyp2);
    int iy = rem / nxp2;
    int ix = rem % nxp2;

    float dx = this_sp->p[0].dx;
    float dy = this_sp->p[0].dy;

    double r_relative = ((double)ix - 1.0) + 0.5 * ((double)dx + 1.0);
    double theta_relative = ((double)iy - 1.0) + 0.5 * ((double)dy + 1.0);

    r_phys = grid->x0 + r_relative * (grid->x1 - grid->x0) / (double)grid->nx;
    double theta_phys = grid->y0 + theta_relative * (grid->y1 - grid->y0) / (double)grid->ny;

    advance_p( this_sp, interpolator_array, field_array );
  }

  double err = fabs(R - r_phys);
  sim_log( dt_test_value << " " << err );
  halt_mp();
  exit(0);
}

begin_diagnostics {
}

begin_particle_injection {
}

begin_current_injection {
}

begin_field_injection {
}

begin_particle_collisions {
}


