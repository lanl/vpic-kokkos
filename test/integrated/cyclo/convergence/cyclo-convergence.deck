begin_globals {
};

begin_initialization {
  // Legacy cyclo test parameters
  double L = 1e10;
  int npart = 1;
  int nstep = 64;

  define_units( 1, 1 );
  define_timestep( dt_test_value );

  define_periodic_grid( 0, 0, 0,
                        L, L, L,
                        1, 1, 1,
                        1, 1, 1 );
  define_material("vacuum",1.0,1.0,0.0);
  define_field_array();

  grid->init_cylindrical_grid();

  // cbz = π/nstep (from legacy)
  field(1,1,1).cbz0 = M_PI / (double)nstep;
  field(1,1,2).cbz0 = M_PI / (double)nstep;

  field_array->copy_to_device();

  species_t* sp;

  // q=2, m=1 from legacy (gamma = 2)
  species_t * this_sp = define_species( "test_species", 2, 1, npart, npart, 0, 0 );

  inject_particle( this_sp,
                   uniform( rng(0), 0, L ),
                   uniform( rng(0), 0, L ),
                   uniform( rng(0), 0, L ),
                   1, 1, 1, // ux=1, uy=1, uz=1 -> gamma=2
                   uniform( rng(0), 0, 1 ),
                   0, 0 );

  LIST_FOR_EACH( sp, species_list ) {
    sp->copy_to_device();
  }
  interpolator_array->copy_to_device();

  load_interpolator_array( interpolator_array, field_array );

  // Measure momentum error (like legacy test)
  double ux_initial = 1.0;
  double uy_initial = 1.0;
  double u_perp_initial = sqrt(ux_initial*ux_initial + uy_initial*uy_initial);

  for( int n=0; n<nstep; n++ ) {
    advance_p( this_sp, interpolator_array, field_array );

    LIST_FOR_EACH( sp, species_list ) {
      sp->copy_to_host();
    }
  }

  // Final momentum
  double ux_final = this_sp->p[0].ux;
  double uy_final = this_sp->p[0].uy;
  double u_perp_final = sqrt(ux_final*ux_final + uy_final*uy_final);

  double err = fabs(u_perp_final - u_perp_initial);

  sim_log( dt_test_value << " " << err );

  halt_mp();
  exit(0);
}

begin_diagnostics {
}

begin_particle_injection {
}

begin_current_injection {
}

begin_field_injection {
}

begin_particle_collisions {
