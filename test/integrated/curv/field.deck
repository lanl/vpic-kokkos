// Test Cyclotron motion in a constant magnetic field
//
// Note:
// wc = q B / m gamma ==> wc dt = q dt B / m gamma ==>
// wc dt = q dt c B / m c gamma ==> wc dt = 2 ( q dt / 2 m c ) ( c B ) / gamma
//
// With c = 1, dt = 1, gamma = 2, q = 2, m = 1
// wc dt = c B
// 2 pi dt / tauc = c B
// 2 pi / Nstep = c B
//
// This input deck was written by:
//   Kevin J Bowers, Ph.D.
//   Plasma Physics Group (X-1)
//   Applied Physics Division
//   Los Alamos National Lab
// March/April 2004 - conversion of c++ test code into an input deck

begin_globals {
  int restart_interval;
  int energies_interval;
  int fields_interval;
  int ehydro_interval;
  int Hhydro_interval;
  int eparticle_interval;
  int Hparticle_interval;
  int quota_check_interval; // How frequently to check if quota exceeded

  int write_restart;        // global flag for all to write restart files
  int write_end_restart;    // global flag for all to write restart files

  FileIO traj_file;
  species_t *this_sp;
};

begin_initialization {
  double ec   = 1.0;  // Charge normalization
  double mi   = 1.0;  // Mass normalization
  double mu0  = 1.0;  // Magnetic constanst
  double b0 = 1.0;    // Magnetic field
  double n0 = 1.0;    // Density
  double eta = 0.0;      // Plasma resistivity.
  double Te = 1.0;
  double nx = 30;
  double ny = 100;
  double nz = 1;

  double qi = 1.0;             // Charge per macro ion
  double dt = 0.01;                           // time step
  double sort_interval = 10;  // How often to sort particles
  int restart_interval = 3000;
  int energies_interval = 200;
  int interval = 50;//int(0.2/(wci*dt));
  int fields_interval = interval;
  int ehydro_interval = interval;
  int Hhydro_interval = interval;
  int eparticle_interval = 40*interval;
  int Hparticle_interval = 0*interval;
  int quota_check_interval     = 100;
  num_step             = 100;
  status_interval      = 2;
  sync_shared_interval = status_interval/2;
  clean_div_e_interval = status_interval/2;
  clean_div_b_interval = status_interval/2;
  global->restart_interval     = restart_interval;
  global->energies_interval    = energies_interval;
  global->fields_interval      = fields_interval;
  global->ehydro_interval      = ehydro_interval;
  global->Hhydro_interval      = Hhydro_interval;
  global->eparticle_interval   = eparticle_interval;
  global->Hparticle_interval   = Hparticle_interval;
  global->quota_check_interval = quota_check_interval;

  define_units(1.0, 1.0);//c, eps0 );
  define_timestep( dt );
  define_periodic_grid( 0.1, 0.0, 0,    // Low corner
                         2.0,  2*M_PI, 1,     // High corner
                         nx, ny, nz,             // Resolution
                         1, 1, 1); // Topology
  grid->init_cylindrical_grid(0.1, 2.0, 0.0, 2*M_PI, 0, 1);
  grid->eta = eta;
  sim_log("Periodic boundaries");
  sim_log("Setting up materials. ");
  define_material( "vacuum", 1 );
  define_field_array(NULL);
  sim_log("Finalized Field Advance");

  sim_log("Setting up particle species. ");
  double sort_method = 1; 
  species_t *ion = define_species("ion", ec, mi, 1, 1, sort_interval, sort_method);
  global->this_sp = ion;
  sim_log( "Loading fields" );
  set_region_field(everywhere, 5.0, 6.0, 7.0, 17., 18., 19.);
  set_region_te( everywhere, Te);
  
  inject_particle( ion,
                    1.0,  // r
                    0,  // theta
                    0.5,  // z
                    0, -100000, 0, // cart vel
                    1.0, // w
                    0, 0 );

  if (rank() == 0) {
    if (global->traj_file.open("trajectory.txt", io_write) != ok) {
      ERROR(("Cannot open trajectory file"));
    }
    global->traj_file.print("# step x y r theta ux uy\n");
  }
}

begin_diagnostics {
  if (rank() == 0) {
    float dx = global->this_sp->p[0].dx;
    float dy = global->this_sp->p[0].dy;
    int mesh = VOXEL_TO_MESH(global->this_sp->p[0].i, grid->nx, grid->ny, grid->nz);
    double x_center = grid->k_curvilinear_mesh_h(mesh, curv_mesh_var::xg);
    double y_center = grid->k_curvilinear_mesh_h(mesh, curv_mesh_var::yg);
    double r_center = grid->k_curvilinear_mesh_h(mesh, curv_mesh_var::h_2);
    double r_phys = r_center + dx * grid->dx/2;
    double theta_center = atan2(y_center, x_center);
    double theta_phys = theta_center + dy * grid->dy/2;
    double x = r_phys * cos(theta_phys);
    double y = r_phys * sin(theta_phys);
    global->traj_file.print("%d %e %e %e %e %e %e\n", 0, x, y, r_phys, theta_phys,
                    global->this_sp->p[0].ux, global->this_sp->p[0].uy);
  }

  field_array->copy_to_device();

  if (rank() == 0) {
    FileIO field_file;
    if (field_file.open("fields.txt", io_write) == ok) {
      field_file.print("# i j k x y r theta jfx jfy ex ey cbx cby cbz\n");
      for (int k = 1; k <= grid->nz; k++) {
        for (int j = 1; j <= grid->ny; j++) {
          for (int i = 1; i <= grid->nx; i++) {
            int voxel_idx = VOXEL(i, j, k, grid->nx, grid->ny, grid->nz);
            int mesh_idx = VOXEL_TO_MESH(voxel_idx, grid->nx, grid->ny, grid->nz);
            double xc = grid->k_curvilinear_mesh_h(mesh_idx, curv_mesh_var::xg);
            double yc = grid->k_curvilinear_mesh_h(mesh_idx, curv_mesh_var::yg);
            double r = grid->k_curvilinear_mesh_h(mesh_idx, curv_mesh_var::h_2);
            double theta = atan2(yc, xc);
            field_t *fld = &field_array->f[voxel_idx];
            field_file.print("%d %d %d %e %e %e %e %e %e %e %e %e %e %e\n",
                           i, j, k, xc, yc, r, theta,
                           fld->jfx, fld->jfy, fld->ex, fld->ey,
                           fld->cbx, fld->cby, fld->cbz);
          }
        }
      }
      field_file.close();
    }
  }
}

begin_particle_injection {
}

begin_current_injection {
}

begin_field_injection {
}

begin_particle_collisions {
}


