//////////////////////////////////////////////////////
//   Ion Acoustic Wave - MINIMAL TEST
//////////////////////////////////////////////////////

begin_globals {
  int hydro_interval;
  double kx;  // wavenumber for diagnostics
};

begin_initialization {
  
  // Physics parameters
  double Ti = 1.0/3.0;      // Ion temperature
  double Te = 1.0/3.0;      // Electron temperature (isothermal)
  double pert = 0.02;       // Density perturbation amplitude
  double Lx = 16.0;         // Domain size
  double kx = 2.0*M_PI/Lx;  // Wavenumber
  
  // Numerical parameters
  double nx = 48;
  double dt = 0.02;
  double nppc = 150000;      // Particles per cell
  double taui = 50.0;       // Run time
  
  num_step = int(taui/dt);
  int hydro_interval = num_step/100;  // 100 dumps total
  
  global->hydro_interval = hydro_interval;
  global->kx = kx;
  
  // Grid setup
  define_units(1.0, 1.0);
  define_timestep(dt);
  define_periodic_grid(-0.5*Lx, -0.5, -0.5,    // Low corner
                        0.5*Lx,  0.5,  0.5,    // High corner
                        nx, 1, 1,               // Resolution
                        1, 1, 1);               // Topology
  
  grid->eos_gamma = 5.0/3.0;
  grid->init_cartesian_grid();
  
  // Materials & fields
  define_material("vacuum", 1);
  define_field_array(NULL);
  set_region_field(everywhere, 0, 0, 0, 0, 0, 0);
  set_region_te(everywhere, Te);
  
  // Species
  double Ni = nppc*nx;
  double qi = 1.0*Lx/Ni;  // Charge per macro-particle
  double vthi = sqrt(Ti);
  
  species_t *ion = define_species("ion", 1.0, 1.0, 1.5*Ni, 0.1*Ni, 10, 1);
  
  // Load particles with sine wave density
  double xmin = grid->x0;
  double xmax = grid->x0 + grid->dx * grid->nx;
  
  repeat(Ni) {
    double x, y, z, r;
    // Rejection sampling for sine profile
    do {
      x = uniform(rng(0), -Lx/2, Lx/2);
      r = uniform(rng(0), 0, 1.0+pert);
    } while(r > (1.0 + pert*sin(kx*x)));
    
    if(x >= xmin && x <= xmax) {
      y = uniform(rng(0), -0.5, 0.5);
      z = uniform(rng(0), -0.5, 0.5);
      
      double ux = normal(rng(0), 0, vthi);
      double uy = normal(rng(0), 0, vthi);
      double uz = normal(rng(0), 0, vthi);
      
      inject_particle(ion, x, y, z, ux, uy, uz, qi, 0, 0);
    }
  }
  
  // Output setup - MINIMAL!
  if(step() == 0) {
    dump_mkdir("hydro");
    dump_mkdir("rundata");
    dump_grid("rundata/grid");
    dump_materials("rundata/materials");
    dump_species("rundata/species");
  }
  
} //begin_initialization

begin_diagnostics {
  
  // Hydro dump
  if(step() > 0 && step() % global->hydro_interval == 0) {
    DumpParameters dp;
    sprintf(dp.baseDir, "hydro");
    sprintf(dp.baseFileName, "hydro");
    dp.format = band;
    dp.stride_x = 1;
    dp.stride_y = 1;
    dp.stride_z = 1;
    hydro_dump("ion", dp);
  }
  
  // Simple amplitude tracker
  if(step() % 10 == 0) {
    double kx = global->kx;
    double cos_sum = 0.0, sin_sum = 0.0, weight_sum = 0.0;
    
    species_t *ion = find_species_name("ion", species_list);
    ion->copy_to_host();

//     field_array->copy_to_device();
//    field_array->kernel->clear_rhof( field_array );
//    k_accumulate_rho_p( field_array, ion );
//    field_array->kernel->k_synchronize_rho( field_array );
    field_array->copy_to_host();
    
    // for(int ip = 0; ip < ion->np; ip++) {
    //   particle_t *p = &ion->p[ip];
    //   double x, y, z;
    //   grid->local_to_global_cart(p->i, p->dx, p->dy, p->dz, x, y, z);
    // //   sim_log("x " << p->dx);
      
    //   cos_sum += p->w * cos(kx * x);
    //   sin_sum += p->w * sin(kx * x);
    //   weight_sum += p->w;
    // }
    // double amplitude = sqrt(cos_sum*cos_sum + sin_sum*sin_sum) / weight_sum;
    // double time = step() * grid->dt;

    double rsum = 0;
    double E_field = 0.0;
    for (int i = 0; i < grid->nv; i++) {
      E_field += (field(i).ex*field(i).ex + field(i).ey*field(i).ey + field(i).ez*field(i).ez) * 
                 grid->dV * grid->eps0;
    }
    double amplitude = E_field*0.5;
    double time = step() * grid->dt;
    
    if(rank() == 0) {
      FileIO fp;
      if(step() == 0) {
        fp.open("wave.txt", io_write);
        fp.print("# time amplitude\n");
      } else {
        fp.open("wave.txt", io_append);
      }
      fp.print("%e %e\n", time, amplitude);
      fp.close();
    }
  }
  
} // end diagnostics

begin_particle_injection { }
begin_current_injection { }
begin_field_injection { }
begin_particle_collisions { }